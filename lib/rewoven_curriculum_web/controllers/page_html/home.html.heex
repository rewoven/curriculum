<.curriculum_page user={assigns[:current_user]} locale={@locale}>
  <section class="hero">
    <div class="container">
      <h1>
        {RewovenCurriculum.I18n.t(@locale, :hero_title_a)}
        <span class="highlight">{RewovenCurriculum.I18n.t(@locale, :hero_title_b)}</span>
      </h1>
      <p>
        {RewovenCurriculum.I18n.t(@locale, :hero_tagline)}
      </p>
      <div class="hero-stat">
        <span>{length(@courses)} {RewovenCurriculum.I18n.t(@locale, :courses_word)}</span>
        <span>{@total_lessons} {RewovenCurriculum.I18n.t(@locale, :lessons_word)}</span>
        <span>{RewovenCurriculum.I18n.t(@locale, :pricing_note)}</span>
      </div>
    </div>
  </section>

  <section class="courses">
    <div class="container">
      <div class="courses-grid">
        <%= for course <- @courses do %>
          <a
            href={"/courses/" <> course.slug}
            class="course-card"
            style={"border-top: 4px solid " <> course.color}
          >
            <div class="course-emoji">{course.emoji}</div>
            <div class="course-title">{course.title}</div>
            <p class="course-tag">{course.tagline}</p>
            <div class="course-meta">
              <span>
                <strong>{length(course.lessons)}</strong>
                {RewovenCurriculum.I18n.t(@locale, :lessons_word)}
              </span>
              <span>·</span>
              <span>{RewovenCurriculum.I18n.t(@locale, :end_of_lesson_quizzes)}</span>
            </div>
          </a>
        <% end %>
      </div>
    </div>
  </section>
</.curriculum_page>
