<.curriculum_page user={assigns[:current_user]} locale={@locale}>
  <section class="course-header">
    <div class="container">
      <div class="course-emoji">🧭</div>
      <h1>404</h1>
      <p style="margin-top:20px;">
        <a href="/" style="font-weight:600;">
          ← {RewovenCurriculum.I18n.t(@locale, :all_courses)}
        </a>
      </p>
    </div>
  </section>
</.curriculum_page>
